# The data archive, about 103 GB. It lives in S3, not in git.
# Pull it with ./sync.sh, and read docs/data_catalog.md to choose what you need.
data/

# Loose cytometry files anywhere else in the tree
*.fcs
*.wsp
*.jo

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/library/
renv/staging/

# Python
.venv/
__pycache__/
*.pyc

# Output
output/
results/
*.html_files/

# The rendered reports. A report embeds every figure as base64, so ten of them
# held 130 MB of the 136 MB that this repository carried. The .qmd source and
# the script it names are both here, and README.md says how to render one.
reports/*.html

# Figures, wherever they land. output/ already covers the analysis figures, and
# this covers anything written elsewhere by hand.
*.png
*.svg
*.pdf
!docs/**/*.png
!docs/**/*.svg

# Transfer logs
logs/*.log

# Agent instruction files, kept local for now
CLAUDE.md
AGENTS.md

# Session working notes, kept local
SESSION_SUMMARY.md

# Design notes, kept local like SESSION_SUMMARY.md
docs/cytokit_prd.md

# The rewrite briefs, kept local like CLAUDE.md and AGENTS.md
prompts/

# Published papers kept locally for comparison, not redistributed
papers/
