#!/usr/bin/env bash
# cytokit: the command surface for analysing your own flow cytometry data.
#
# An agent calls this and never calls R directly. Every recipe runs inside the
# pinned Podman image, reads the data path read only, and writes one bundle under
# the output path.
#
# The data path is mounted read only on purpose. An FCS file is a measurement that
# cannot be taken again, and no analysis needs to write to its input.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
IMAGE="${CYTOKIT_IMAGE:-everything-flow-cytometry:latest}"

# A recipe here writes a timestamped bundle. The others write one file that the
# caller names, so they take no label and no output root.
BUNDLE_RECIPES="inspect compensate gate cluster annotate proportions compare claims"

usage() {
    cat <<'EOF'
cytokit — flow cytometry analysis you can drive from a conversation

Usage:
  cytokit inspect     --data PATH [--recursive] [--out DIR] [--label NAME]
  cytokit template    --data PATH --out FILE [--recursive] [--force]
  cytokit definitions --data PATH --out FILE [--recursive] [--force]
                                  [--markers "CD3,CD4"]
                                  [--markers "APC-A=CD3,PE-A=CD4"]
                                  [--populations "T cells,B cells"]
  cytokit compensate  --data PATH [--controls DIR] [--recursive] [--out DIR]
                                  [--cofactor 150] [--unstained PATTERN]
                                  [--seed 42]
  cytokit gate        --data PATH --template FILE [--out DIR] [--cores N]
                                  [--recursive] [--seed 42] [--no-compensate]
                                  [--no-transform] [--no-save-gates]
  cytokit cluster     --gates BUNDLE [--parent POP] | --data PATH
                                  [--markers "CD3,CD4"] [--metaclusters 12]
                                  [--grid 10] [--events 50000] [--no-umap]
                                  [--seed 42] [--out DIR]
  cytokit annotate    --clusters BUNDLE --definitions FILE [--out DIR]
                                  [--margin 0.1]
  cytokit proportions --counts BUNDLE --metadata FILE [--out DIR]
                                  [--sample-column sample]
  cytokit compare     --proportions BUNDLE --group COL [--population NAME]
                                  [--all-populations] [--value COL] [--out DIR]
  cytokit claims      --claims FILE --results FILE [--out DIR]
                                  [--tolerance 0.05]
  cytokit reproduce   [--analysis NAME] [--out DIR]

  cytokit list        show the recipes and their state
  cytokit build       build the analysis image
  cytokit shell       open a shell in the image
  cytokit version     print the image and the R version

Start with inspect. It reports the panel, the markers and the compensation
state, and every later recipe reads what it prints.

A gating template and a cell type definitions table are per panel, so nobody
arrives with one. template and definitions write a valid empty file with the
panel's markers in it, for you to fill in with the scientist.

cluster groups the events with FlowSOM and draws them with UMAP. It does not
name a cluster, because a name is a claim about an antibody. Point it at the
bundle that gate wrote, so the clustering runs inside a gate.

gate runs a template you filled in and reports what every gate kept. It names
the gates that kept every event and the gates that kept almost none, because
both look like a result in a table.

compensate answers "is my data compensated". It correlates every pair of
markers before and after the stored matrix, because the keyword does not answer
it. Give it --controls to compute a matrix from the single stains as well.

When a file leaves $PnS empty, the panel reads as detector names and a cell
type built on one means nothing. Give definitions the mapping instead, in the
detector=antibody form, and it writes the antibody names and records where they
came from.

Add --recursive when the FCS files sit below the folder you name. That is how a
deposit arrives when you unzip it.

Paths are read on the host. The data path is mounted read only.
EOF
}

require_podman() {
    if ! command -v podman >/dev/null 2>&1; then
        echo "Error: podman is not installed or is not on PATH." >&2
        exit 1
    fi
}

require_image() {
    require_podman
    if ! podman image exists "$IMAGE"; then
        echo "Error: the image $IMAGE does not exist." >&2
        echo "Build it with:  cytokit build" >&2
        exit 1
    fi
}

# The recipe needs the data on a path inside the container. The host path is
# resolved here so that a relative path, a symlink and ~ all work.
absolute() {
    local path="$1"
    if [[ -d "$path" ]]; then
        (cd "$path" && pwd)
        return
    fi
    local dir
    dir="$(dirname "$path")"
    if [[ -d "$dir" ]]; then
        dir="$(cd "$dir" && pwd)"
    else
        # The folder is not there. Resolve it against the current directory
        # rather than fail, so that an error names the path that was typed.
        case "$dir" in
            /*) ;;
            .)  dir="$PWD" ;;
            *)  dir="$PWD/$dir" ;;
        esac
    fi
    echo "$dir/$(basename "$path")"
}

run_recipe() {
    local recipe="$1"; shift
    require_image

    local data_host="" out_host="" controls_host="" args=() index=1
    local -a extra_mounts=() extra_hosts=()
    local -a passthrough=()

    # --data is mounted read only. --out is mounted read and write when it points
    # outside the repository, because the bundle has to land where it was asked
    # for and not inside the image.
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --data) data_host="$(absolute "${2:?--data needs a path}")"
                    # A folder becomes /indata. A single file keeps its name
                    # inside /indata, because its parent is what gets mounted.
                    if [[ -d "$data_host" ]]; then
                        passthrough+=(--data "/indata")
                    else
                        passthrough+=(--data "/indata/$(basename "$data_host")")
                    fi
                    shift 2 ;;
            --out)  out_host="${2:?--out needs a path}"; shift 2 ;;
            # A table the caller wrote is an input like the data, so it
            # mounts read only. Each flag has its own mount point, so two of
            # them can name files in two different folders.
            --template|--definitions|--metadata|--counts|--proportions|--gates|--clusters|--claims|--results)
                    flag="${1#--}"
                    file_host="$(absolute "${2:?needs a path}")"
                    extra_mounts+=("$(dirname "$file_host"):/in_${flag}:ro,z")
                    extra_hosts+=("CYTOKIT_${flag^^}_HOST=$(dirname "$file_host")")
                    passthrough+=("$1" "/in_${flag}/$(basename "$file_host")")
                    shift 2 ;;
            # The controls are a second folder of FCS files, and they are as
            # irreplaceable as the samples, so they mount read only too.
            --controls)
                    controls_host="$(absolute "${2:?--controls needs a path}")"
                    if [[ -d "$controls_host" ]]; then
                        passthrough+=(--controls "/incontrols")
                    else
                        passthrough+=(--controls \
                            "/incontrols/$(basename "$controls_host")")
                    fi
                    shift 2 ;;
            *)      passthrough+=("$1"); shift ;;
        esac
    done

    # data_mount is the folder that lands on /indata. A recipe maps a path it
    # prints back to the host with it, so it has to be the folder and not the
    # file, even when --data named one file.
    # out_mount is the folder that lands on /outdata, for the same reason.
    local data_mount="" out_mount="" controls_mount=""
    local mounts=(--volume "$REPO_ROOT:/work:z")
    if [[ -n "$data_host" ]]; then
        if [[ -d "$data_host" ]]; then
            data_mount="$data_host"
        else
            data_mount="$(dirname "$data_host")"
        fi
        mounts+=(--volume "$data_mount:/indata:ro,z")
    fi
    if [[ -n "$controls_host" ]]; then
        if [[ -d "$controls_host" ]]; then
            controls_mount="$controls_host"
        else
            controls_mount="$(dirname "$controls_host")"
        fi
        mounts+=(--volume "$controls_mount:/incontrols:ro,z")
    fi
    local mount
    for mount in "${extra_mounts[@]+"${extra_mounts[@]}"}"; do
        mounts+=(--volume "$mount")
    done

    # An --out inside the repository already has a mount. One outside needs its
    # own, and its parent has to exist so that podman does not create a folder
    # owned by root.
    if [[ -n "$out_host" ]]; then
        # The folder that --out names has to exist before it is resolved and
        # before podman mounts it, or podman creates one owned by root.
        local out_abs
        if [[ "$recipe" == "template" || "$recipe" == "definitions" ]]; then
            mkdir -p "$(dirname "$out_host")"
        else
            mkdir -p "$out_host"
        fi
        out_abs="$(absolute "$out_host")"
        if [[ "$out_abs" == "$REPO_ROOT"/* ]]; then
            passthrough+=(--out "${out_abs#$REPO_ROOT/}")
        else
            if [[ "$recipe" == "template" || "$recipe" == "definitions" ]]; then
                out_mount="$(dirname "$out_abs")"
                mkdir -p "$out_mount"
                passthrough+=(--out "/outdata/$(basename "$out_abs")")
            else
                out_mount="$out_abs"
                mkdir -p "$out_mount"
                passthrough+=(--out "/outdata")
            fi
            mounts+=(--volume "$out_mount:/outdata:z")
        fi
    fi

    # A recipe that writes a bundle names it after the input. The recipe sees
    # /indata, so the host basename is passed in as the label. A recipe that
    # writes a single file takes no label.
    case " $BUNDLE_RECIPES " in
        *" $recipe "*)
            if [[ -n "$data_host" ]] &&
               [[ ! " ${passthrough[*]} " == *" --label "* ]]; then
                passthrough+=(--label "$(basename "$data_host")")
            fi
            ;;
    esac

    local -a host_env=()
    local pair
    for pair in "${extra_hosts[@]+"${extra_hosts[@]}"}"; do
        host_env+=(--env "$pair")
    done

    podman run --rm \
        --userns keep-id \
        "${host_env[@]+"${host_env[@]}"}" \
        --env "CYTOKIT_IMAGE=$IMAGE" \
        --env "CYTOKIT_DATA_HOST=${data_mount:-}" \
        --env "CYTOKIT_CONTROLS_HOST=${controls_mount:-}" \
        --env "CYTOKIT_OUT_HOST=${out_mount:-}" \
        --env "CYTOKIT_IMAGE_DIGEST=$(podman image inspect --format '{{.Digest}}' "$IMAGE" 2>/dev/null || echo unknown)" \
        "${mounts[@]}" \
        --workdir /work \
        "$IMAGE" Rscript "scripts/cytokit/${recipe}.R" "${passthrough[@]}"
}

case "${1:-help}" in
    inspect|template|definitions|compensate|gate|cluster|annotate|proportions|compare|claims|reproduce)
        recipe="$1"; shift
        run_recipe "$recipe" "$@"
        ;;
    list)
        cat <<'EOF'
Recipe        State    What it does
inspect       ready    Panel, markers, event counts, compensation state
template      ready    An empty openCyto gating template for this panel
definitions   ready    An empty cell type definitions table for this panel
compensate    ready    The stored matrix, and whether it lowers the correlation
gate          ready    Run a template, write counts and a gate tree
cluster       ready    FlowSOM and UMAP, inside a gate when asked
annotate      ready    Label each cluster from a definitions table
proportions   ready    Per sample frequencies joined to a metadata table
compare       ready    Box plot of proportion by treatment, with the test
claims        ready    A verdict for every claim in a claims table
reproduce     ready    Rebuild one of the analyses in this repository

The plan is in docs/cytokit.md.
EOF
        ;;
    build)
        require_podman
        exec "$REPO_ROOT/containers/build.sh" "${@:2}"
        ;;
    shell)
        require_image
        exec podman run --rm -it --userns keep-id \
            --volume "$REPO_ROOT:/work:z" --workdir /work "$IMAGE" /bin/bash
        ;;
    version)
        require_image
        echo "image  $IMAGE"
        podman image inspect --format 'digest {{.Digest}}' "$IMAGE"
        podman run --rm "$IMAGE" Rscript -e 'cat("R     ", R.version.string, "\n")'
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo >&2
        usage >&2
        exit 1
        ;;
esac
